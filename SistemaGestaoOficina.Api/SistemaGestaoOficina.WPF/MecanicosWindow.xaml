<Window x:Class="SistemaGestaoOficina.WPF.MecanicosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Mecânicos"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="#2D3748">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0,0,0">

                <TextBlock Text="🔧"
                           FontSize="28"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <TextBlock Text="Gestão de Mecânicos"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1"
              Margin="30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Lado esquerdo -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dados do mecânico -->
                <GroupBox Grid.Row="0"
                          Header="Dados do mecânico"
                          FontWeight="Bold"
                          Padding="20"
                          Background="White">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Id -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Id:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <TextBox x:Name="txtId"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="0,0,0,15"
                                 IsReadOnly="True"/>

                        <!-- Nome -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Nome:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <TextBox x:Name="txtNome"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="0,0,0,15"
                                 MaxLength="50"
                                 PreviewTextInput="txtNome_PreviewTextInput"/>

                        <!-- Especialidade -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Especialidade:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <ComboBox x:Name="comboBoxEspecialidade"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Height="32"
                                  Margin="0,0,0,15"/>

                        <!-- Horário -->
                        <TextBlock Grid.Row="3"
                                Grid.Column="0"
                                Text="Horário:"
                     VerticalAlignment="Center"
                           Margin="0,0,10,15"/>

                        <TextBox x:Name="txtHorario"
                                        Grid.Row="3"
                                     Grid.Column="1"
                                         Height="32"
                                   Margin="0,0,0,15"
                                   IsReadOnly="True"
                                 Text="09:00 às 18:00 - Segunda a Sábado"/>

                        <!-- Contacto -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Contacto:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtContacto"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Height="32"
                                 MaxLength="15"
                                 PreviewTextInput="txtContacto_PreviewTextInput"/>

                    </Grid>

                </GroupBox>

                <!-- Botões da esquerda -->
                <WrapPanel Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0">

                    <Button x:Name="btnApagar"
                            Content="Apagar"
                            Width="120"
                            Height="38"
                            Margin="0,0,12,0"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0" Click="btnApagar_Click"/>

                    <Button x:Name="btnGuardar"
                            Content="Guardar"
                            Width="120"
                            Height="38"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0" Click="btnGuardar_Click"/>

                </WrapPanel>

            </Grid>

            <!-- Lado direito -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Lista de mecânicos -->
                <GroupBox Grid.Row="0"
                          Header="Lista de mecânicos"
                          FontWeight="Bold"
                          Padding="10"
                          Background="White">

                    <ListBox x:Name="listBoxMecanicos"/>

                </GroupBox>

                <!-- Botões da direita -->
                <WrapPanel Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0">

                    <Button x:Name="btnEditar"
                            Content="Editar"
                            Width="120"
                            Height="38"
                            Margin="0,0,12,0" Click="btnEditar_Click"/>

                    <Button x:Name="btnDesativar"
                            Content="Desativar"
                            Width="120"
                            Height="38"
                            Margin="0,0,12,0"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0" Click="btnDesativar_Click"/>

                    <Button x:Name="btnAtivar"
                            Content="Ativar"
                            Width="120"
                            Height="38"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0" Click="btnAtivar_Click"/>

                </WrapPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>
