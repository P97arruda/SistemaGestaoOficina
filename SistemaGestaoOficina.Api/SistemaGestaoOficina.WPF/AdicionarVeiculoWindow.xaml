<Window x:Class="SistemaGestaoOficina.WPF.AdicionarVeiculoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar Veículo"
        Height="620"
        Width="850"
        MinHeight="580"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="#2D3748">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0,0,0">

                <TextBlock Text="🚗"
                           FontSize="28"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <TextBlock Text="Adicionar Veículo"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1"
              Margin="35">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulário -->
            <GroupBox Grid.Column="0"
                      Header="Dados do veículo"
                      FontWeight="Bold"
                      Padding="20"
                      Background="White"
                      VerticalAlignment="Top">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cliente -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Cliente:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <ComboBox x:Name="comboBoxCliente"
                              Grid.Row="0"
                              Grid.Column="1"
                              Height="32"
                              Margin="0,0,0,15"/>

                    <!-- Marca -->
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Marca:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <ComboBox x:Name="comboBoxMarca"
                              Grid.Row="1"
                              Grid.Column="1"
                              Height="32"
                              Margin="0,0,0,15"/>

                    <!-- Modelo -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Modelo:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <TextBox x:Name="txtModelo"
                             Grid.Row="2"
                             Grid.Column="1"
                             Height="32"
                             Margin="0,0,0,15"
                              MaxLength="20"/>

                    <!-- Matrícula -->
                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Matrícula:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <TextBox x:Name="txtMatricula"
                             Grid.Row="3"
                             Grid.Column="1"
                             Height="32"
                             Margin="0,0,0,15"
                             MaxLength="10"/>

                    <!-- Ano -->
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Ano:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <ComboBox x:Name="comboBoxAno"
                                      Grid.Row="4"
                                      Grid.Column="1"
                                      Height="32"
                                     Margin="0,0,0,15"/>
                    

                    <!-- Combustível -->
                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Combustível:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <ComboBox x:Name="comboBoxCombustivel"
                              Grid.Row="5"
                              Grid.Column="1"
                              Height="32"
                              Margin="0,0,0,15">
                        
                    </ComboBox>

                    <!-- Quilometragem -->
                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Quilometragem:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="txtQuilometragem"
                             Grid.Row="6"
                             Grid.Column="1"
                             Height="32"
                             PreviewTextInput="txtQuilometragem_PreviewTextInput"/>

                </Grid>

            </GroupBox>

            <!-- Área livre à direita -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="25"
                    VerticalAlignment="Top">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="🚗"
                               FontSize="65"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,15"/>

                    <TextBlock Text="Novo veículo"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Preencha os dados do veículo e associe-o a um cliente."
                               FontSize="13"
                               Foreground="#6B7280"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,20"/>

                </StackPanel>

            </Border>

            <!-- Botões -->
            <WrapPanel Grid.Column="0"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="0,25,0,0">

                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Width="120"
                        Height="38"
                        Margin="0,0,12,0"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0" Click="btnCancelar_Click"/>

                <Button x:Name="btnGuardar"
                        Content="Guardar"
                        Width="120"
                        Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnGuardar_Click"/>

            </WrapPanel>

        </Grid>

    </Grid>

</Window>