<Window x:Class="SistemaGestaoOficina.WPF.ClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Clientes"
        Height="825"
        Width="1285"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="#2D3748">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0,0,0">

                <TextBlock Text="👥"
                           FontSize="28"
                           Foreground="White"
                           Margin="0,0,15,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Gestão de Clientes"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1"
              Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Lado esquerdo -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dados do cliente -->
                <GroupBox Grid.Row="0"
                          Header="Dados do cliente"
                          FontWeight="Bold"
                          Padding="20"
                          Background="White">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Id -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,15">

                            <TextBlock Text="Id"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtId"
                                     Height="32"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <!-- Contacto -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,0,0,15">

                            <TextBlock Text="Contacto"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtContacto"
                                     Height="32"
                                     MaxLength="15"
                                     PreviewTextInput="txtContacto_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Nome -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,15">

                            <TextBlock Text="Nome"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtNome"
                                     Height="32"
                                     MaxLength="50"
                                     PreviewTextInput="txtNome_PreviewTextInput"/>
                        </StackPanel>

                        <!-- NIF -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,0,0,15">

                            <TextBlock Text="NIF"
                                    Margin="0,0,0,5"/>

                            <TextBox x:Name="txtNif"
                                    Height="32"
                                    MaxLength="9"
                                    PreviewTextInput="txtNif_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Apelido -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">

                            <TextBlock Text="Apelido"
                                       Margin="0,0,0,5"/>

                                <TextBox x:Name="txtApelido"
                                     Height="32"
                                     MaxLength="50"
                                     PreviewTextInput="txtNome_PreviewTextInput"/>
                            </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">

                            <TextBlock Text="Email"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtEmail"
                                     Height="32"
                                     MaxLength="50"/>
                            
                        </StackPanel>

                    </Grid>

                </GroupBox>

                <!-- Botões -->
                <WrapPanel Grid.Row="1"
                           Margin="0,15,0,0">

                    <Button x:Name="btnApagar"
                            Content="Apagar"
                            Width="110"
                            Height="35"
                            Margin="0,0,10,10"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0" Click="btnApagar_Click"/>

                    <Button x:Name="btnEditar"
                            Content="Editar"
                            Width="110"
                            Height="35"
                            Margin="0,0,10,10" 
                            Click="btnEditar_Click"/>


                    <Button x:Name="btnMarcacao"
                            Content="Marcação"
                            Width="110"
                            Height="35"
                            Margin="0,0,10,10" Click="btnMarcacao_Click"/>

                    <Button x:Name="btnAdicionarCarro"
                            Content="Adicionar carro"
                            Width="130"
                            Height="35"
                            Margin="0,0,10,10" Click="btnAdicionarCarro_Click"/>

                    <Button x:Name="btnGuardar"
                            Content="Guardar"
                            Width="110"
                            Height="35"
                            Margin="0,0,10,10"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnGuardar_Click"/>

                </WrapPanel>

                <!-- Pesquisa -->
                <Grid Grid.Row="3">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Lista de clientes"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Pesquisar cliente:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtPesquisarCliente"
                                 Grid.Column="1"
                                 Height="32"/>

                        <Button x:Name="btnPesquisarCliente"
                                Grid.Column="2"
                                Content="🔍"
                                Height="32"
                                Margin="5,0,0,0"/>
                    </Grid>

                </Grid>

                <!-- Lista de clientes -->
                <DataGrid x:Name="dataGridClientes"
                          Grid.Row="4"
                          Margin="0,10,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          SelectionChanged="dataGridClientes_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id"
                        Binding="{Binding Id}"
                        Width="45"/>

                        <DataGridTextColumn Header="Nome"
                        Binding="{Binding Nome}"
                        Width="1.1*"/>

                        <DataGridTextColumn Header="Apelido"
                        Binding="{Binding Apelido}"
                        Width="1.1*"/>

                        <DataGridTextColumn Header="Contacto"
                        Binding="{Binding Contacto}"
                        Width="1.1*"/>

                        <DataGridTextColumn Header="NIF"
                        Binding="{Binding NIF}"
                        Width="1.1*"/>

                        <DataGridTextColumn Header="Email"
                        Binding="{Binding Email}"
                        Width="1.8*"/>
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

            <!-- Lado direito -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Pesquisa de marcações -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Pesquisar marcação:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="txtPesquisarMarcacao"
                             Grid.Column="1"
                             Height="32"/>

                    <Button x:Name="btnPesquisarMarcacao"
                            Grid.Column="2"
                            Content="🔍"
                            Height="32"
                            Margin="5,0,0,0"/>

                </Grid>

                <!-- Marcações -->
                <GroupBox Grid.Row="1"
                          Header="Marcações"
                          FontWeight="Bold"
                          Background="White">

                    <DataGrid x:Name="dataGridMarcacoes"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False">


                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Matrícula"
                                                Binding="{Binding Matricula}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Serviço"
                                                Binding="{Binding TipoServico}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Data"
                                                Binding="{Binding DataHora}"
                                                Width="170"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

                <!-- Botões de marcação -->
                <WrapPanel Grid.Row="2"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0">

                    <Button x:Name="btnCancelarMarcacao"
                            Content="Cancelar marcação"
                            Width="150"
                            Height="35"
                            Margin="0,0,10,0"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0" Click="btnCancelarMarcacao_Click"/>

                    <Button x:Name="btnEditarMarcacao"
                            Content="Editar marcação"
                            Width="140"
                            Height="35" Click="btnEditarMarcacao_Click"/>

                </WrapPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>
