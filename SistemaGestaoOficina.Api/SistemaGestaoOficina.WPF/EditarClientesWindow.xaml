<Window x:Class="SistemaGestaoOficina.WPF.EditarClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Cliente"
        Height="620"
        Width="1000"
        MinHeight="520"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="#2D3748">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0,0,0">

                <TextBlock Text="👤"
                           FontSize="28"
                           Foreground="White"
                           Margin="0,0,15,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Editar Cliente"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1"
              Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Dados do cliente -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Header="Dados do cliente"
                          FontWeight="Bold"
                          Padding="20"
                          Background="White">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Id -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Id:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <TextBox x:Name="txtId"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="0,0,0,15"
                                 IsReadOnly="True"/>

                        <!-- Nome -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Nome:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <TextBox x:Name="txtNome"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="0,0,0,15"
                                 MaxLength="50"
                                 PreviewTextInput="txtNome_PreviewTextInput"/>

                        <!-- Apelido -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Apelido:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <TextBox x:Name="txtApelido"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="0,0,0,15"
                                 MaxLength="50"
                                 PreviewTextInput="txtNome_PreviewTextInput"/>

                        <!-- Contacto -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Contacto:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <TextBox x:Name="txtContacto"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="0,0,0,15"
                                 MaxLength="15"
                                 PreviewTextInput="txtContacto_PreviewTextInput"/>

                        <!-- NIF -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="NIF:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,15"/>

                        <TextBox x:Name="txtNif"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="0,0,0,15"
                                 MaxLength="9"
                                 PreviewTextInput="txtNif_PreviewTextInput"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Email:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtEmail"
                                 Grid.Row="5"
                                 Grid.Column="1"
                                 Height="32"
                                 MaxLength="35"/>

                    </Grid>

                </GroupBox>

                <!-- Botões -->
                <WrapPanel Grid.Row="1"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center">

                    <Button x:Name="btnApagarVeiculo"
                            Content="Apagar veículo"
                            Width="130"
                            Height="35"
                            Margin="0,0,10,10"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button x:Name="btnCancelar"
                            Content="Cancelar"
                            Width="110"
                            Height="35"
                            Margin="0,0,10,10"/>

                    <Button x:Name="btnEditarVeiculo"
                            Content="Editar veículo"
                            Width="130"
                            Height="35"
                            Margin="0,0,10,10"/>

                    <Button x:Name="btnGuardar"
                            Content="Guardar"
                            Width="110"
                            Height="35"
                            Margin="0,0,10,10"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0" Click="btnGuardar_Click"/>

                </WrapPanel>

            </Grid>

            <!-- Lista de veículos -->
            <GroupBox Grid.Column="2"
                      Header="Veículos do cliente"
                      FontWeight="Bold"
                      Background="White">

                <DataGrid x:Name="dataGridVeiculos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding Id}"
                                            Width="60"/>

                        <DataGridTextColumn Header="Matrícula"
                                            Binding="{Binding Matricula}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Marca"
                                            Binding="{Binding Marca}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Modelo"
                                            Binding="{Binding Modelo}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

        </Grid>

    </Grid>

</Window>
