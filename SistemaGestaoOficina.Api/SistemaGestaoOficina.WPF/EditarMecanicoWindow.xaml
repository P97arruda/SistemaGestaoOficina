<Window x:Class="SistemaGestaoOficina.WPF.EditarMecanicoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Mecânico"
        Height="600"
        Width="850"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="#2D3748">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0,0,0">

                <TextBlock Text="🔧"
                           FontSize="28"
                           Foreground="White"
                           Margin="0,0,15,0"/>

                <TextBlock Text="Editar Mecânico"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

            </StackPanel>

        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1"
              Margin="35">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Dados -->
            <GroupBox Grid.Column="0"
                      Header="Dados do mecânico"
                      FontWeight="Bold"
                      Padding="20"
                      Background="White"
                      VerticalAlignment="Top">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Id -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Id:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <TextBox x:Name="txtId"
                             Grid.Row="0"
                             Grid.Column="1"
                             Height="32"
                             Margin="0,0,0,15"
                             IsReadOnly="True"/>

                    <!-- Nome -->
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Nome:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <TextBox x:Name="txtNome"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="32"
                             Margin="0,0,0,15"
                             MaxLength="50"
                             PreviewTextInput="txtNome_PreviewTextInput"/>

                    <!-- Especialidade -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Especialidade:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <ComboBox x:Name="comboBoxEspecialidade"
                              Grid.Row="2"
                              Grid.Column="1"
                              Height="32"
                              Margin="0,0,0,15"/>

                    <!-- Horário -->
                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Horário:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,15"/>

                    <TextBox x:Name="txtHorario"
                             Grid.Row="3"
                             Grid.Column="1"
                             Height="32"
                             Margin="0,0,0,15"
                             IsReadOnly="True"
                             Text="09:00 às 18:00 - Segunda a Sábado"/>

                    <!-- Contacto -->
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Contacto:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="txtContacto"
                             Grid.Row="4"
                             Grid.Column="1"
                             Height="32"
                             MaxLength="15"
                             PreviewTextInput="txtContacto_PreviewTextInput"/>

                </Grid>

            </GroupBox>

            <!-- Área direita -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="25"
                    VerticalAlignment="Top">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="🔧"
                               FontSize="65"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,15"/>

                    <TextBlock Text="Editar mecânico"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Atualize os dados do mecânico."
                               FontSize="13"
                               Foreground="#6B7280"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,20"/>

                </StackPanel>

            </Border>

            <!-- Botões -->
            <WrapPanel Grid.Column="0"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="0,25,0,0">

                <Button x:Name="btnFechar"
                        Content="Fechar"
                        Width="120"
                        Height="38"
                        Margin="0,0,12,0"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0" Click="btnFechar_Click"/>

                <Button x:Name="btnGuardar"
                        Content="Guardar"
                        Width="120"
                        Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0" Click="btnGuardar_Click"/>

            </WrapPanel>

        </Grid>

    </Grid>

</Window>