<Window x:Class="SistemaGestaoOficina.WPF.ReparacoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Reparações"
        Height="760"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="#2D3748">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0,0,0">

                <TextBlock Text="🔧"
                           FontSize="28"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <TextBlock Text="Gestão de Reparações"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1"
              Margin="25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lado esquerdo -->
            <GroupBox Grid.Column="0"
                      Header="Dados da reparação"
                      FontWeight="Bold"
                      Background="White"
                      Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Marcação -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,15">

                        <TextBlock Text="Marcação"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="comboBoxMarcacao"
                                  Height="32"/>

                    </StackPanel>

                    <!-- Peça e valor -->
                    <Grid Grid.Row="1"
                          Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Peça utilizada"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtPeca"
                                     Height="32"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Valor da peça (€)"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtValorPeca"
                                     Height="32"/>

                        </StackPanel>

                    </Grid>

                    <!-- Botões peças -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,0,0,15">

                        <Button x:Name="btnRemoverPeca"
                                Content="Remover"
                                Width="95"
                                Height="32"
                                Margin="0,0,10,0"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button x:Name="btnAdicionarPeca"
                                Content="Adicionar"
                                Width="95"
                                Height="32"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"/>

                    </StackPanel>

                    <!-- Datas -->
                    <Grid Grid.Row="3"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Data de início"
                                       Margin="0,0,0,5"/>

                            <DatePicker x:Name="datePickerInicio"
                                        Height="32"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Data de fim"
                                       Margin="0,0,0,5"/>

                            <DatePicker x:Name="datePickerFim"
                                        Height="32"/>

                        </StackPanel>

                    </Grid>

                    <!-- Mecânico -->
                    <StackPanel Grid.Row="4"
                                Margin="0,0,0,10">

                        <TextBlock Text="Mecânico"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="comboBoxMecanico"
                                  Height="32"
                                  DisplayMemberPath="Nome"/>

                    </StackPanel>

                    <!-- Lista mecânicos -->
                    <ListBox x:Name="listBoxMecanicos"
                             Grid.Row="5"
                             MinHeight="140"/>

                    <!-- Botões mecânicos -->
                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">

                        <Button x:Name="btnRemoverMecanico"
                                Content="Remover"
                                Width="95"
                                Height="32"
                                Margin="0,0,10,0"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button x:Name="btnAdicionarMecanico"
                                Content="Adicionar"
                                Width="95"
                                Height="32"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"/>

                    </StackPanel>

                </Grid>

            </GroupBox>

            <!-- Centro -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="190"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Header="Reparações em curso"
                          FontWeight="Bold"
                          Background="White"
                          Padding="10">

                    <ListBox x:Name="listBoxEmCurso"/>

                </GroupBox>

                <GroupBox Grid.Row="2"
                          Header="Peças e valores"
                          FontWeight="Bold"
                          Background="White"
                          Padding="10">

                    <ListBox x:Name="listBoxPecas"/>

                </GroupBox>

            </Grid>

            <!-- Lado direito -->
            <Grid Grid.Column="4">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Header="Reparações concluídas"
                          FontWeight="Bold"
                          Background="White"
                          Padding="10">

                    <ListBox x:Name="listBoxConcluidas"/>

                </GroupBox>

                <GroupBox Grid.Row="2"
                          Header="Conclusão da reparação"
                          FontWeight="Bold"
                          Background="White"
                          Padding="15">

                    <StackPanel>

                        <TextBlock Text="Custo total (€)"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="txtCustoTotal"
                                 Height="32"
                                 IsReadOnly="True"
                                 Margin="0,0,0,15"/>

                        <Button x:Name="btnConcluir"
                                Content="Concluir reparação"
                                Width="160"
                                Height="38"
                                HorizontalAlignment="Left"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"/>

                    </StackPanel>

                </GroupBox>

            </Grid>

        </Grid>

    </Grid>

</Window>
